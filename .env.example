# SeekrAI Configuration
# Copy this file to .env and update with your actual values

# Flask Secret Key (generate a random string for production)
SECRET_KEY=your-secret-key-change-this-in-production

# Kerberos Configuration
KERBEROS_REALM=IPA.REDHAT.COM

# LDAP Configuration (Red Hat IPA/IdM)
LDAP_SERVER=ldap://ipa.redhat.com
LDAP_BASE_DN=dc=redhat,dc=com
LDAP_USER_BASE=cn=users,cn=accounts

# SSO Authentication (default: enabled)
# Set to 1 only for local development without VPN access
DISABLE_SSO=0

# ask-sre semantic SOP search (optional)
# Local checkout of https://gitlab.cee.redhat.com/service/ask-sre — see SETUP_ASK_SRE.md
ASK_SRE_DIR=~/code/ask-sre
# Port the ask-sre MCP server listens on (must match MCP_SERVER_URL below)
ASK_SRE_PORT=8000
# URL unified_search.py uses to reach the ask-sre MCP server
MCP_SERVER_URL=http://localhost:8000
# Name of the pgvector PostgreSQL container ask-sre depends on
PGVECTOR_CONTAINER=pgvector
